+/// Проецирует точку сферы в эквидистантную цилиндрическую карту.
+/// ref_lon задаёт локальную ветвь долготы, чтобы полигон не пересекал карту по шву.
+#[inline]
+fn project_map_point(dir: Vec3, ref_lon: f32, radius: f32, height: f32) -> Vec3 {
+    let dir = dir.normalize_or_zero();
+    let latitude = dir.y.clamp(-1.0, 1.0).asin();
+    let mut longitude = dir.x.atan2(dir.z);
+    if longitude - ref_lon > std::f32::consts::PI {
+        longitude -= std::f32::consts::TAU;
+    } else if longitude - ref_lon < -std::f32::consts::PI {
+        longitude += std::f32::consts::TAU;
+    }
+    Vec3::new(longitude * radius, latitude * radius, height)
+}
+
+#[inline]
+fn cell_reference_longitude(center: Vec3, corners: &[Vec3]) -> f32 {
+    if center.x * center.x + center.z * center.z > 1e-8 {
+        center.x.atan2(center.z)
+    } else {
+        corners
+            .first()
+            .map(|p| p.x.atan2(p.z))
+            .unwrap_or(0.0)
+    }
+}
