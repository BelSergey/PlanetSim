-                };
-
-                let hydrology = if missing_stage.is_none() {
-                    match save_file
-                        .hydrology_bytes
-                        .as_deref()
-                        .map(bincode::deserialize::<HydrologyLayer>)
-                    {
-                        Some(Ok(loaded_hydro)) if loaded_hydro.biomes.len() == num_cells => {
