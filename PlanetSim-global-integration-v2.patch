-                    Some(Err(_)) => {
-                        let mut g = GeologyLayer::default();
-                        g.resize(num_cells);
-                        missing_stage = Some((
-                            PipelineStage::Tectonics,
-                            "формат слоя тектоники устарел".to_string(),
-                        ));
-                        g
-                    }
-                    None => {
-                        let mut g = GeologyLayer::default();
-                        g.resize(num_cells);
-                        missing_stage = Some((
-                            PipelineStage::Tectonics,
