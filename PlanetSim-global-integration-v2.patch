-
-                thread_logger.start_step("Запись контейнера .planet на диск...");
-                let _ = fs::create_dir_all(PLANET_SAVE_DIR);
-                let path = Path::new(PLANET_SAVE_DIR).join(format!("{}.planet", clean_name));
