+
+/// Визуальная поверхность планеты.
+#[derive(Component)]
+pub struct Globe;
+
+/// Корневой объект звёздной системы; вращается только пользовательским вводом.
+#[derive(Component)]
+pub struct StarSystemRoot;
+
+#[derive(Resource, Default, PartialEq, Eq, Clone, Copy)]
+pub enum ViewMode {
+    #[default]
+    Globe3D,
+    _Flat2D,
+}
+
+#[derive(Resource, Default, PartialEq, Eq, Clone, Copy)]
+pub enum MapOverlay {
+    #[default]
+    SpaceView,
+    Elevation,
+    TectonicPlates,
+    Continentality,
+    Lithology,
+    Ruggedness,
+    CrustAge,
+    TectonicStress,
+    Temperature,
