+// src/viewport/mesh_globe.rs
+
+use crate::world::topology::WorldTopology;
+use rayon::prelude::*;
+use bevy::{
+    asset::RenderAssetUsages,
+    prelude::*,
+    render::mesh::{Indices, PrimitiveTopology},
+};
+
+use crate::domains::{
+    hydrology::{HydrologyConfig, HydrologyLayer},
+    tectonics::tectonics_data::GeologyLayer,
+};
+
+/// Оценивает точное количество вершин и индексов с учётом стенок.
+fn globe_mesh_sizes(topology: &WorldTopology, elevations: &[f32]) -> (usize, usize) {
+    topology.cells.par_iter().enumerate().map(|(cell_id, cell)| {
+        let Some(&height) = elevations.get(cell_id) else { return (0, 0); };
+        let walls = cell.neighbors.iter()
+            .filter(|&&neighbor_id| elevations.get(neighbor_id).is_some_and(|&neighbor| height > neighbor))
+            .count();
+        let corners = cell.corners.len();
+        (1 + corners + walls * 4, corners * 3 + walls * 6)
+    }).reduce(|| (0, 0), |a, b| (a.0 + b.0, a.1 + b.1))
+}
+
+#[derive(Default)]
+struct GlobeMeshChunk {
+    positions: Vec<[f32; 3]>,
+    normals: Vec<[f32; 3]>,
+    colors: Vec<[f32; 4]>,
+    indices: Vec<u32>,
+}
+
+pub fn build_globe_mesh(
+    topology: &WorldTopology,
+    elevations: &[f32],
+    is_ocean: &[bool],
+    flatten_water: bool,
+    cell_colors: &[[f32; 4]],
+    radius: f32,
+    height_scale: f32,
+) -> Mesh {
+    const CELLS_PER_CHUNK: usize = 512;
+    let (vertex_capacity, index_capacity) = globe_mesh_sizes(topology, elevations);
+
+    let chunks: Vec<GlobeMeshChunk> = topology.cells.par_chunks(CELLS_PER_CHUNK)
+        .enumerate()
+        .map(|(chunk_index, cells)| {
+            let mut chunk = GlobeMeshChunk::default();
+            let first_cell = chunk_index * CELLS_PER_CHUNK;
+
+            for (local_id, cell) in cells.iter().enumerate() {
+                let cell_id = first_cell + local_id;
+                let Some(&real_h) = elevations.get(cell_id) else { continue; };
+                let top_color = cell_colors.get(cell_id).copied().unwrap_or([1.0; 4]);
+                let cell_ocean = is_ocean.get(cell_id).copied().unwrap_or(real_h <= 0.0);
+                let render_h = if flatten_water && cell_ocean { real_h.max(0.0) } else { real_h };
+                let top_radius = radius + render_h * height_scale;
+                let top_normal = cell.center.to_array();
+                let base_idx = chunk.positions.len() as u32;
+
+                chunk.positions.push((cell.center * top_radius).to_array());
+                chunk.normals.push(top_normal);
+                chunk.colors.push(top_color);
+
+                for &corner in &cell.corners {
+                    chunk.positions.push((corner * top_radius).to_array());
+                    chunk.normals.push(top_normal);
+                    chunk.colors.push(top_color);
+                }
+
+                for k in 0..cell.corners.len() as u32 {
+                    let next = (k + 1) % cell.corners.len() as u32;
+                    chunk.indices.extend_from_slice(&[base_idx, base_idx + 1 + k, base_idx + 1 + next]);
+                }
+
+                let wall_color = [top_color[0] * 0.75, top_color[1] * 0.75, top_color[2] * 0.75, top_color[3]];
+                for k in 0..cell.corners.len() {
+                    let Some(&neighbor_h) = cell.neighbors.get(k).and_then(|id| elevations.get(*id)) else { continue; };
+                    if real_h <= neighbor_h { continue; }
+                    let neighbor_id = cell.neighbors[k];
+                    let neighbor_ocean = is_ocean.get(neighbor_id).copied().unwrap_or(neighbor_h <= 0.0);
+                    let render_neighbor_h = if flatten_water && neighbor_ocean { neighbor_h.max(0.0) } else { neighbor_h };
+                    let bottom_radius = radius + render_neighbor_h * height_scale;
+                    let c1 = cell.corners[k];
+                    let c2 = cell.corners[(k + 1) % cell.corners.len()];
+                    let top_left = c1 * top_radius;
+                    let top_right = c2 * top_radius;
+                    let bottom_left = c1 * bottom_radius;
+                    let bottom_right = c2 * bottom_radius;
+                    let wall_normal = (bottom_left - top_left).cross(top_right - top_left).normalize_or_zero().to_array();
+                    let wall_base = chunk.positions.len() as u32;
+                    chunk.positions.extend_from_slice(&[top_left.to_array(), top_right.to_array(), bottom_left.to_array(), bottom_right.to_array()]);
+                    chunk.normals.extend_from_slice(&[wall_normal; 4]);
+                    chunk.colors.extend_from_slice(&[wall_color; 4]);
+                    chunk.indices.extend_from_slice(&[wall_base, wall_base + 2, wall_base + 1, wall_base + 1, wall_base + 2, wall_base + 3]);
+                }
+            }
+            chunk
+        }).collect();
+
+    let mut positions = Vec::with_capacity(vertex_capacity);
+    let mut normals = Vec::with_capacity(vertex_capacity);
+    let mut colors = Vec::with_capacity(vertex_capacity);
+    let mut indices = Vec::with_capacity(index_capacity);
+    for chunk in chunks {
+        let offset = positions.len() as u32;
+        positions.extend(chunk.positions);
+        normals.extend(chunk.normals);
+        colors.extend(chunk.colors);
+        indices.extend(chunk.indices.into_iter().map(|i| i + offset));
+    }
+
+    let mut mesh = Mesh::new(PrimitiveTopology::TriangleList, RenderAssetUsages::default());
+    mesh.insert_attribute(Mesh::ATTRIBUTE_POSITION, positions);
+    mesh.insert_attribute(Mesh::ATTRIBUTE_NORMAL, normals);
+    mesh.insert_attribute(Mesh::ATTRIBUTE_COLOR, colors);
+    mesh.insert_indices(Indices::U32(indices));
+    mesh
+}
