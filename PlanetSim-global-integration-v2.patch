+fn stage_label(stage: PipelineStage) -> &'static str {
+    match stage {
+        PipelineStage::Tectonics => "Тектоника (с нуля)",
+        PipelineStage::Climate => "Климат -> Гидрология",
+        PipelineStage::Hydrology => "Гидрология и Биомы",
+    }
+}
